# upstream-processor configuration (M8.1). Copy to .env and fill in real values.
# All variables are prefixed UPSTREAM_ and consumed via app/config.py.

# --- Required ---------------------------------------------------------------
# Shared secret for the M8.0 /v1/internal/processor/* endpoints. Must match the
# api-server's UPSTREAM_PROCESSOR_WEBHOOK_SECRET. NEVER commit the real value.
UPSTREAM_PROCESSOR_WEBHOOK_SECRET=replace-me

# --- Optional (defaults shown) ---------------------------------------------
UPSTREAM_API_BASE_URL=https://api.upstreamcv.com
UPSTREAM_PROCESSOR_ID=proc_local_mock_001
UPSTREAM_POLL_INTERVAL_SECONDS=5
UPSTREAM_MOCK_OBSERVATION_INTERVAL_SECONDS=5
UPSTREAM_LOG_LEVEL=INFO
UPSTREAM_ELIGIBLE_SESSION_LIMIT=50

# --- Shutdown budget (M8.2B cleanup; DeepStream-safe defaults) --------------
# Docker-backed DeepStream workers need enough time to `docker stop` the
# decode container, reap the subprocess, and post the final `stopped` status.
# The mock runtime exits much faster, so these larger defaults are safe for
# mixed runtimes. All env-overridable.
UPSTREAM_FINAL_STATUS_TIMEOUT_SECONDS=15
UPSTREAM_OVERALL_SHUTDOWN_TIMEOUT_SECONDS=25
UPSTREAM_DEEPSTREAM_PROCESS_STOP_TIMEOUT_SECONDS=5

# --- DeepStream runtime (M8.2B decode probe + M8.2C1-B inference probe) -----
# Dev/test only: force every eligible session to this package without mutating
# production camera config. Decode probe: deepstream.decode_probe.v0.
# Inference probe (M8.2C1-B): deepstream.inference_probe.v0.
# UPSTREAM_FORCE_PACKAGE_ID=deepstream.inference_probe.v0
#
# DeepStream 8.0 by default: 7.1 decodes on Blackwell but FAILS inference
# (TensorRT 10.3 -> "Unsupported SM: 0xc00", M8.2C1-A). 8.0 (TensorRT 10.9 /
# CUDA 12.8) runs nvinfer on the RTX 5070 Ti and also decodes fine.
UPSTREAM_DEEPSTREAM_IMAGE=nvcr.io/nvidia/deepstream:8.0-samples-multiarch
UPSTREAM_DEEPSTREAM_RTSP_TRANSPORT=tcp
UPSTREAM_DEEPSTREAM_PROBE_TIMEOUT_SECONDS=30
UPSTREAM_DEEPSTREAM_DOCKER_NETWORK=host
# Inference-probe knobs (bounded nvinfer smoke; status/log-only evidence,
# NO observations, NO metadata extraction):
UPSTREAM_DEEPSTREAM_INFERENCE_TIMEOUT_SECONDS=60
UPSTREAM_DEEPSTREAM_INFERENCE_MODEL=trafficcamnet
# Empty => auto temp dir under the system tempdir (cleaned up on stop).
UPSTREAM_DEEPSTREAM_INFERENCE_OUTPUT_DIR=
UPSTREAM_DEEPSTREAM_KEEP_TEMP_FILES=false

# --- P2 supervisor-managed metadata probe (deepstream.metadata_probe.v0) ---
# Separate, pyds-derived DeepStream 8.0 image (built from
# docker/Dockerfile.pyds; see the manual P2 probe milestone). The container
# runs the in-container pyds pad probe; the outer supervisor parses
# UPSTREAM_METADATA=<json> lines, validates them as NeutralFrameMetadata,
# pushes through BoundedBridgeQueue, and surfaces counters + queue_stats
# in the worker status payload. Still NO observations, NO API writes.
UPSTREAM_DEEPSTREAM_PYDS_IMAGE=upstream-deepstream:8.0-pyds-v1.2.2
UPSTREAM_DEEPSTREAM_METADATA_PROBE_TIMEOUT_SECONDS=60
UPSTREAM_DEEPSTREAM_METADATA_QUEUE_MAXSIZE=256
# drop_newest | drop_oldest -- producer-side eviction policy when full.
UPSTREAM_DEEPSTREAM_METADATA_QUEUE_DROP_POLICY=drop_newest
UPSTREAM_DEEPSTREAM_METADATA_SAMPLE_LIMIT=3

# --- P3 tracker-probe (deepstream.tracker_probe.v0) -----------------------
# Same pyds metadata path as metadata_probe, with nvtracker spliced in after
# nvinfer so NvDsObjectMeta.object_id is a real stable id across frames.
# v0 supports only the no-ReID IOU tracker (algorithm=iou) which proves
# stable ids without a ReID model. NvDCF / NvSORT / NvDeepSORT are reserved
# for future tuning. Library path is the DS 8.0 default. tracker-width /
# tracker-height must be multiples of 32 for NvDCF/NvDeepSORT (harmless for
# IOU). Sample-limit caps the size of the tracker_ids_sample field in the
# worker's status payload.
UPSTREAM_DEEPSTREAM_TRACKER_LIB_PATH=/opt/nvidia/deepstream/deepstream/lib/libnvds_nvmultiobjecttracker.so
UPSTREAM_DEEPSTREAM_TRACKER_ALGORITHM=iou
UPSTREAM_DEEPSTREAM_TRACKER_WIDTH=960
UPSTREAM_DEEPSTREAM_TRACKER_HEIGHT=544
UPSTREAM_DEEPSTREAM_TRACKER_IDS_SAMPLE_LIMIT=10
