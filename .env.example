# upstream-processor configuration (M8.1). Copy to .env and fill in real values.
# All variables are prefixed UPSTREAM_ and consumed via app/config.py.

# --- Required ---------------------------------------------------------------
# Shared secret for the M8.0 /v1/internal/processor/* endpoints. Must match the
# api-server's UPSTREAM_PROCESSOR_WEBHOOK_SECRET. NEVER commit the real value.
UPSTREAM_PROCESSOR_WEBHOOK_SECRET=replace-me

# --- Optional (defaults shown) ---------------------------------------------
UPSTREAM_API_BASE_URL=https://api.upstreamcv.com
UPSTREAM_PROCESSOR_ID=proc_local_mock_001
UPSTREAM_POLL_INTERVAL_SECONDS=5
UPSTREAM_MOCK_OBSERVATION_INTERVAL_SECONDS=5
UPSTREAM_LOG_LEVEL=INFO
UPSTREAM_ELIGIBLE_SESSION_LIMIT=50

# --- Shutdown budget (M8.2B cleanup; DeepStream-safe defaults) --------------
# Docker-backed DeepStream workers need enough time to `docker stop` the
# decode container, reap the subprocess, and post the final `stopped` status.
# The mock runtime exits much faster, so these larger defaults are safe for
# mixed runtimes. All env-overridable.
UPSTREAM_FINAL_STATUS_TIMEOUT_SECONDS=15
UPSTREAM_OVERALL_SHUTDOWN_TIMEOUT_SECONDS=25
UPSTREAM_DEEPSTREAM_PROCESS_STOP_TIMEOUT_SECONDS=5

# --- DeepStream runtime (M8.2B decode probe + M8.2C1-B inference probe) -----
# Dev/test only: force every eligible session to this package without mutating
# production camera config. Decode probe: deepstream.decode_probe.v0.
# Inference probe (M8.2C1-B): deepstream.inference_probe.v0.
# UPSTREAM_FORCE_PACKAGE_ID=deepstream.inference_probe.v0
#
# DeepStream 8.0 by default: 7.1 decodes on Blackwell but FAILS inference
# (TensorRT 10.3 -> "Unsupported SM: 0xc00", M8.2C1-A). 8.0 (TensorRT 10.9 /
# CUDA 12.8) runs nvinfer on the RTX 5070 Ti and also decodes fine.
UPSTREAM_DEEPSTREAM_IMAGE=nvcr.io/nvidia/deepstream:8.0-samples-multiarch
UPSTREAM_DEEPSTREAM_RTSP_TRANSPORT=tcp
UPSTREAM_DEEPSTREAM_PROBE_TIMEOUT_SECONDS=30
UPSTREAM_DEEPSTREAM_DOCKER_NETWORK=host
# Inference-probe knobs (bounded nvinfer smoke; status/log-only evidence,
# NO observations, NO metadata extraction):
UPSTREAM_DEEPSTREAM_INFERENCE_TIMEOUT_SECONDS=60
UPSTREAM_DEEPSTREAM_INFERENCE_MODEL=trafficcamnet
# Empty => auto temp dir under the system tempdir (cleaned up on stop).
UPSTREAM_DEEPSTREAM_INFERENCE_OUTPUT_DIR=
UPSTREAM_DEEPSTREAM_KEEP_TEMP_FILES=false

# --- P2 supervisor-managed metadata probe (deepstream.metadata_probe.v0) ---
# Separate, pyds-derived DeepStream 8.0 image (built from
# docker/Dockerfile.pyds; see the manual P2 probe milestone). The container
# runs the in-container pyds pad probe; the outer supervisor parses
# UPSTREAM_METADATA=<json> lines, validates them as NeutralFrameMetadata,
# pushes through BoundedBridgeQueue, and surfaces counters + queue_stats
# in the worker status payload. Still NO observations, NO API writes.
UPSTREAM_DEEPSTREAM_PYDS_IMAGE=upstream-deepstream:8.0-pyds-v1.2.2
UPSTREAM_DEEPSTREAM_METADATA_PROBE_TIMEOUT_SECONDS=60
UPSTREAM_DEEPSTREAM_METADATA_QUEUE_MAXSIZE=256
# drop_newest | drop_oldest -- producer-side eviction policy when full.
UPSTREAM_DEEPSTREAM_METADATA_QUEUE_DROP_POLICY=drop_newest
UPSTREAM_DEEPSTREAM_METADATA_SAMPLE_LIMIT=3

# --- P3 tracker-probe (deepstream.tracker_probe.v0) -----------------------
# Same pyds metadata path as metadata_probe, with nvtracker spliced in after
# nvinfer so NvDsObjectMeta.object_id is a real stable id across frames.
# v0 supports only the no-ReID IOU tracker (algorithm=iou) which proves
# stable ids without a ReID model. NvDCF / NvSORT / NvDeepSORT are reserved
# for future tuning. Library path is the DS 8.0 default. tracker-width /
# tracker-height must be multiples of 32 for NvDCF/NvDeepSORT (harmless for
# IOU). Sample-limit caps the size of the tracker_ids_sample field in the
# worker's status payload.
UPSTREAM_DEEPSTREAM_TRACKER_LIB_PATH=/opt/nvidia/deepstream/deepstream/lib/libnvds_nvmultiobjecttracker.so
UPSTREAM_DEEPSTREAM_TRACKER_ALGORITHM=iou
UPSTREAM_DEEPSTREAM_TRACKER_WIDTH=960
UPSTREAM_DEEPSTREAM_TRACKER_HEIGHT=544
UPSTREAM_DEEPSTREAM_TRACKER_IDS_SAMPLE_LIMIT=10

# --- P3.5 analytics-probe (deepstream.analytics_probe.v0) -----------------
# Same pyds path as tracker_probe with nvdsanalytics spliced in after
# nvtracker. v0 ships a hand-authored ROI + line-crossing config aimed at
# 1280x720 frames (central ROI 20-80% wide x 10-90% tall, horizontal line
# across the middle). The only operator knob is the bounded sample of
# distinct analytics labels (ROI / LC / direction) the worker surfaces in
# the status payload. Dashboard-driven geometry is a later milestone.
UPSTREAM_DEEPSTREAM_ANALYTICS_LABELS_SAMPLE_LIMIT=20

# --- P4-C ROI occupancy emission policy ----------------------------------
# Heartbeat cadence when the ROI count is steady (default 30 s). Lower
# values produce more frequent observations; setting to 0 (test-only)
# emits on every frame regardless of count.
UPSTREAM_DEEPSTREAM_ROI_MIN_INTERVAL_SECONDS=30.0

# --- P4-C cleanup: ROI debounce / hysteresis -----------------------------
# Number of consecutive frames a NEW ROI count must hold before a
# change observation emits. P4-C's live run showed TrafficCamNet's
# detection count flaps on edge-case frames (counts flip 0 <-> 1
# even with a stationary operator), and an undamped on-change policy
# turned each flap into a real observation. Setting >=2 suppresses
# short flaps; 5 (default) requires ~166 ms of stability at 30 fps.
# 1 reproduces the P4-C immediate-change behavior. Values <1 are
# rejected at processor startup.
UPSTREAM_DEEPSTREAM_ROI_CHANGE_STABILITY_FRAMES=5

# --- P4-D zone transition emission policy --------------------------------
# Number of consecutive OBSERVED frames a tracked object's zone
# membership (inside / outside) must hold before the corresponding
# processor.zone_entered or processor.zone_exited observation
# commits. Object disappearance does NOT emit zone_exited — only an
# observed-with-no-label trajectory does. Default 5 (~166 ms at 30
# fps); raise for noisier scenes, lower for faster reactivity.
# Values < 1 are rejected at processor startup.
UPSTREAM_DEEPSTREAM_ZONE_MEMBERSHIP_STABILITY_FRAMES=5

# --- P4-D follow-up: analytics ROI geometry + class filter ---------------
# P4-D live verification showed the previous hard-coded ROI margin
# (20% horizontal / 10% vertical) put nvdsanalytics's per-object
# reference point (bbox bottom-center) outside the ROI when the
# operator stood near the bottom of the frame. The default below
# (5% margin on all sides → ROI covers central 90% × 90%) is much
# more forgiving for camera-above-operator scenes. Range [0.0, 0.5).
UPSTREAM_DEEPSTREAM_ANALYTICS_ROI_MARGIN_PCT=0.05

# nvdsanalytics per-section class filter. "all" (or "-1") matches
# every detected class. A single integer like "2" filters to that
# class only. Comma-lists are NOT supported (the parser takes a
# single int per section). The probe default is "all" because
# TrafficCamNet sometimes misclassifies people as cars and we want
# the probe to register ROI labels regardless of class. Production
# scenes are expected to narrow per-deployment.
UPSTREAM_DEEPSTREAM_ANALYTICS_CLASS_IDS=all

# --- P4-E dwell emission policy ------------------------------------------
# dwell_update_interval_seconds: how often processor.dwell_updated is
# emitted while a tracked object is still inside the zone. Default 30s;
# live testing typically uses 5-10s. Setting to 0 (test-only) emits
# every frame. Must be > 0.
UPSTREAM_DEEPSTREAM_DWELL_UPDATE_INTERVAL_SECONDS=30.0

# dwell_exceeded_threshold_seconds: total dwell duration at which
# processor.dwell_exceeded fires once per session. Default 60s; live
# testing typically uses 10-15s. Must be > 0. Subsequent re-entries
# start a NEW dwell_session_id with a fresh threshold-emitted state.
UPSTREAM_DEEPSTREAM_DWELL_EXCEEDED_THRESHOLD_SECONDS=60.0

# --- P5-C latest perception snapshot ------------------------------------
# A low-rate JSON snapshot of what the analytics worker currently sees
# (detected objects + configured ROI/line geometry), POSTed to the
# dedicated perception-snapshot endpoint. This is NOT an observation: it
# is latest-state for a dashboard overlay, one upserted row per camera,
# separate from the append-only observations log. Analytics runtime only.
#
# perception_snapshot_enabled: master on/off switch. Default true.
UPSTREAM_PERCEPTION_SNAPSHOT_ENABLED=true
# perception_snapshot_interval_seconds: minimum seconds between snapshot
# POSTs (~1/s default). Never posts per-frame.
UPSTREAM_PERCEPTION_SNAPSHOT_INTERVAL_SECONDS=1.0
# perception_snapshot_max_objects: hard cap on objects[] in one snapshot
# to bound payload size; debug.objects_seen keeps the true count.
UPSTREAM_PERCEPTION_SNAPSHOT_MAX_OBJECTS=50

# --- P5-F perception-fanout hot path (optional; both required to enable) ---
# Publish detection snapshots to the perception-fanout sidecar
# (upstream-streaming-server) for the 10-15 Hz dashboard overlay. The secret
# is the SIDECAR's dedicated publish secret — NOT the api-server webhook
# secret. Disabled when either is unset; the 1 Hz cold path is unaffected.
# UPSTREAM_FANOUT_PUBLISH_URL=http://127.0.0.1:18990/v1/publish
# UPSTREAM_FANOUT_PUBLISH_SECRET=
# UPSTREAM_FANOUT_PUBLISH_HZ=12
# UPSTREAM_FANOUT_PUBLISH_IDLE_HZ=0.5
