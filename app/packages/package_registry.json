    },
    {
      "package_id": "deepstream.inference_probe.v0",
      "display_name": "DeepStream Inference Probe v0",
      "runtime": "deepstream",
      "description": "DeepStream 8.0 nvinfer sample-model (TrafficCamNet) inference probe. RTSP decode + nvinfer; detection evidence is status/log-only (KITTI dump). No observations, no metadata extraction, no pyds.",
      "outputs": [],
      "supports": {
        "inference_probe": true
      },
      "status": "probe",
      "model_id": "trafficcamnet_v1",
      "compute_tier": "low",
      "pricing_tier": "free_probe"
    },
    {
      "package_id": "deepstream.metadata_probe.v0",
      "display_name": "DeepStream Metadata Probe v0",
      "runtime": "deepstream",
      "description": "DeepStream 8.0 + pyds metadata probe. Runs a pyds pad probe in a DS 8.0 + pyds container, walks NvDsBatchMeta/NvDsFrameMeta/NvDsObjectMeta, and surfaces neutral per-frame metadata through the BoundedBridgeQueue/MetadataSource seam into the worker's status payload (counters + class_counts + queue_stats). Status/debug evidence only -- no observations, no metadata adapter, no API writes.",
      "outputs": [],
      "supports": {
        "metadata_probe": true
      },
      "status": "probe",
      "model_id": "trafficcamnet_v1",
      "compute_tier": "low",
      "pricing_tier": "free_probe"
    },
    {
      "package_id": "deepstream.tracker_probe.v0",
      "display_name": "DeepStream Tracker Probe v0",
      "runtime": "deepstream",
      "description": "DeepStream 8.0 + pyds metadata probe with nvtracker enabled. Same pyds pad probe as deepstream.metadata_probe.v0, but inserts an nvtracker element (IOU low-level config by default) after nvinfer so NvDsObjectMeta.object_id is a real stable tracker id across frames. The pad probe runs on the tracker src pad. Status payload adds tracker_enabled, has_tracker_id, unique_tracker_ids_count, and a bounded tracker_ids_sample. Still status/debug evidence only -- no observations, no metadata adapter, no API writes.",
      "outputs": [],
      "supports": {
        "tracker_probe": true
      },
      "status": "probe",
      "model_id": "trafficcamnet_v1",
      "tracker_profile_id": "deepstream_iou_fast_v1",
      "compute_tier": "low",
      "pricing_tier": "free_probe"
    },
    {
      "package_id": "deepstream.analytics_probe.v0",
      "display_name": "DeepStream Analytics Probe v0",
      "runtime": "deepstream",
      "description": "DeepStream 8.0 + pyds metadata probe with nvtracker AND nvdsanalytics enabled (TrafficCamNet sample detector). Same pyds pad probe as deepstream.tracker_probe.v0 but inserts an nvdsanalytics element after nvtracker; the pad probe walks NvDsUserMeta on frames (NvDsAnalyticsFrameMeta: objInROIcnt / objLCCumCnt / objLCCurrCnt / ocStatus) and objects (NvDsAnalyticsObjInfo: roiStatus / lcStatus / dirStatus / ocStatus). Geometry is the operator-saved dashboard geometry when present (P6-C), else the probe-default central ROI + midline. With an ObservationWriter wired (P4-B..P4-E) this mode EMITS the line/ROI/zone/dwell observation types listed in outputs; known limitation: TrafficCamNet misclassifies people in non-traffic scenes (P4-D), which is what the YOLOX analytics package exists to fix.",
      "outputs": [
        "processor.line_crossing",
        "processor.line_crossing_object",
        "processor.roi_occupancy",
        "processor.zone_entered",
        "processor.zone_exited",
        "processor.dwell_started",
        "processor.dwell_updated",
        "processor.dwell_exceeded"
      ],
      "supports": {
        "analytics_probe": true
      },
      "status": "probe",
      "model_id": "trafficcamnet_v1",
      "tracker_profile_id": "deepstream_iou_fast_v1",
      "analytics_profile_id": "deepstream_nvdsanalytics_probe_v1",
      "compute_tier": "low",
      "pricing_tier": "free_probe",
      "category": "people_analytics",
      "setup_complexity": "medium",
      "supported_shapes": [
        "polygon_roi",
        "line_segment"
      ],
      "supported_triggers": [
        "line_crossing",
        "roi_occupancy",
        "zone_entered",
        "zone_exited",
        "dwell_exceeded"
      ],
      "observation_policy": "debounced_events_plus_interval_heartbeats",
      "test_mode_safe": true,
      "production_ready": false,
      "best_for": [
        "traffic_scenes",
        "probe_baselines"
      ],
      "not_recommended_for": [
        "person_analytics_in_non_traffic_scenes",
        "production_sla"
      ]
    },
    {
